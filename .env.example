# ── Copy this file to .env and fill in your values ───────────────────────────
# Single shared .env — read by both frontend (VITE_*) and backend

# ── Frontend (Vite exposes only VITE_* variables to the browser) ──────────────
VITE_API_URL=http://localhost:5000/api

# ── Backend ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# PostgreSQL — must match docker-compose.yml credentials
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/attendance_db"

# JWT — change JWT_SECRET to a long random string in production
JWT_SECRET="change-this-to-a-long-random-string-in-production"
JWT_EXPIRES_IN=7d

# CORS
FRONTEND_URL=http://localhost:5173
