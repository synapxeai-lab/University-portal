# Render environment variables for the backend (render.yaml sets most of these).
# Locally, the backend reads the root ../../.env instead.

NODE_ENV=production

# Set automatically from the Render Postgres database (Internal Database URL)
DATABASE_URL=

# Long random string — render.yaml generates one automatically
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Your Vercel URL(s), comma-separated, no trailing slash
FRONTEND_URL=https://your-app.vercel.app

# Optional: set to true to also allow Vercel preview deployments (*.vercel.app)
ALLOW_VERCEL_PREVIEWS=false
